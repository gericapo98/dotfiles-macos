# Rosé Pine palette lifted from theme.css
# Background swapped to Rosé Pine's own dark base (#191724) — same darkness
# as navy, but it's actually in-family with the rest of the palette instead
# of a plain blue clashing against the pinks/golds/purples.
background = #191724
foreground = #cfc5ef
# Selection mimics the blog's h1 highlight (light on teal #31748f)
selection-background = #31748f
selection-foreground = #cfc5ef
cursor-color = #cfc5ef
cursor-text = #191724

palette = 0=#26233a
palette = 1=#eb6f92
palette = 2=#31748f
palette = 3=#f6c177
palette = 4=#4fb8de
palette = 5=#c4a7e7
palette = 6=#22d3ee
palette = 7=#cfc5ef
palette = 8=#6e6a86
palette = 9=#eb6f92
palette = 10=#31748f
palette = 11=#f6c177
palette = 12=#6fd3f2
palette = 13=#c4a7e7
palette = 14=#22d3ee
palette = 15=#ddd4f6

font-family = Monaco
font-size = 12

# CRT effect — swap for any file in ~/.config/ghostty/shaders/
# (crt.glsl, bettercrt.glsl, retro-terminal.glsl, bloom.glsl,
#  glow-rgbsplit-twitchy.glsl, vhs.glsl). Stack by repeating the key.
# vhs.glsl is a self-contained pipeline (curve+scanlines+grain+chroma
# bleed+vignette) inspired by vereis.com's paint-texture look — don't
# stack it with bettercrt.glsl, both apply barrel curve and compound.
custom-shader = ~/.config/ghostty/shaders/vhs.glsl
# Uncomment to layer soft glow on top — bloom is purely additive, no
# curve/vignette of its own, so it composes safely after vhs.
#custom-shader = ~/.config/ghostty/shaders/bloom.glsl
# Keep shaders animating even when idle (needed for the bloom pulse)
custom-shader-animation = always
